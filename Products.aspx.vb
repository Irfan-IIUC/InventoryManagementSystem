
' Imports basic .NET classes for events and general operations.
Imports System

' Imports DataTable, DataRow, and other data-related classes.
Imports System.Data

' Imports ConfigurationManager for reading the database connection string from Web.config.
Imports System.Configuration

' Imports SQL Server classes for connecting to the database and executing queries.
Imports System.Data.SqlClient

' Imports culture-related classes for parsing numbers using a specific number format.
Imports System.Globalization


' Defines the Products page class.
Public Class Products

    ' Inherits ASP.NET Web Forms page functionality.
    Inherits System.Web.UI.Page


    ' Page_Init runs during the initialization stage of the page lifecycle.
    ' It checks whether the user is logged in before allowing access to the page.
    Protected Sub Page_Init(sender As Object, e As EventArgs) Handles Me.Init

        ' If the session does not contain a logged-in user's email, redirect to Login.aspx.
        If Session("UserEmail") Is Nothing Then

            ' Redirect the user without immediately ending the current response.
            Response.Redirect("Login.aspx", False)

            ' Completes the current request to prevent further pipeline processing.
            Context.ApplicationInstance.CompleteRequest()

        End If

    End Sub


    ' Handles commands generated by buttons inside the product GridView.
    ' Supports deleting and editing products based on the CommandName.
    Protected Sub gvProducts_RowCommand(sender As Object, e As GridViewCommandEventArgs) Handles gvProducts.RowCommand

        ' Reads the ProductID passed through the clicked button's CommandArgument.
        Dim productID As Integer = Convert.ToInt32(e.CommandArgument)


        ' Checks whether the user clicked the Delete button.
        If e.CommandName = "DeleteProduct" Then

            ' Retrieves the SQL Server connection string named InventoryDB from Web.config.
            Dim cs As String =
                ConfigurationManager.ConnectionStrings("InventoryDB").ConnectionString

            ' Handles possible errors during the deletion operation.
            Try

                ' Creates and automatically disposes of the SQL connection.
                Using con As New SqlConnection(cs)

                    ' SQL query to delete the selected product using its ProductID.
                    Dim query As String =
                        "DELETE FROM dbo.Products WHERE ProductID = @ProductID"

                    ' Creates the SQL command and associates it with the connection.
                    Using cmd As New SqlCommand(query, con)

                        ' Supplies the selected product ID as a SQL parameter.
                        cmd.Parameters.AddWithValue("@ProductID", productID)

                        ' Opens the database connection.
                        con.Open()

                        ' Executes the DELETE query and returns the number of affected rows.
                        Dim rowsAffected As Integer = cmd.ExecuteNonQuery()

                        ' Checks whether a product was successfully deleted.
                        If rowsAffected > 0 Then

                            ' Displays a JavaScript alert confirming successful deletion.
                            ClientScript.RegisterStartupScript(
                                Me.GetType(), "msg",
                                "alert('Product deleted successfully!');", True)

                        End If

                    End Using
                End Using

                ' Reloads the product table and dashboard statistics after deletion.
                LoadProducts()

            Catch ex As Exception

                ' Displays an error message if deletion fails.
                ClientScript.RegisterStartupScript(
                    Me.GetType(), "msg",
                    "alert('Unable to delete product. Please try again.');", True)

            End Try


            ' Checks whether the user clicked the Edit button.
        ElseIf e.CommandName = "EditProduct" Then

            ' Retrieves the database connection string.
            Dim cs As String =
                ConfigurationManager.ConnectionStrings("InventoryDB").ConnectionString

            ' Opens a SQL connection for retrieving the selected product.
            Using con As New SqlConnection(cs)

                ' Selects the fields required to populate the edit form.
                ' The WHERE condition retrieves only the selected product.
                Dim query As String =
                    "SELECT ProductID, ProductCode, ProductName, Price, StockQuantity " &
                    "FROM dbo.Products WHERE ProductID = @ProductID"

                ' Creates the SQL command for retrieving the product.
                Using cmd As New SqlCommand(query, con)

                    ' Supplies the selected product ID as a parameter.
                    cmd.Parameters.AddWithValue("@ProductID", productID)

                    ' Opens the database connection.
                    con.Open()

                    ' Executes the SELECT query and reads the returned record.
                    Using reader As SqlDataReader = cmd.ExecuteReader()

                        ' Checks whether a matching product was found.
                        If reader.Read() Then

                            ' Stores the selected product ID in the hidden field.
                            hfEditProductID.Value = reader("ProductID").ToString()

                            ' Fills the edit form with the existing product code.
                            txtEditProductCode.Text = reader("ProductCode").ToString()

                            ' Fills the edit form with the existing product name.
                            txtEditProductName.Text = reader("ProductName").ToString()

                            ' Fills the edit form with the existing product price.
                            txtEditPrice.Text = reader("Price").ToString()

                            ' Fills the edit form with the current stock quantity.
                            txtEditStock.Text = reader("StockQuantity").ToString()

                            ' Makes the Edit Product panel visible.
                            pnlEditProduct.Visible = True

                        End If

                    End Using
                End Using
            End Using

        End If

    End Sub


    ' Page_Load runs whenever the page loads, including postbacks.
    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load

        ' Loads the products only on the first page load.
        ' Avoids automatically reloading the page data on every postback.
        If Not IsPostBack Then

            ' Loads product records and updates the dashboard.
            LoadProducts()

        End If

    End Sub


    ' Loads product records from SQL Server and updates the dashboard and GridView.
    Private Sub LoadProducts()

        ' Retrieves the database connection string from Web.config.
        Dim cs As String =
            ConfigurationManager.ConnectionStrings("InventoryDB").ConnectionString

        ' Creates a database connection and disposes of it automatically.
        Using con As New SqlConnection(cs)

            ' Selects product information from the Products table.
            ' TotalValue is calculated by multiplying Price by StockQuantity.
            ' Results are sorted by ProductID in descending order.
            Dim query As String =
                "SELECT ProductID, ProductCode, ProductName, Price, StockQuantity, " &
                "(Price * StockQuantity) AS TotalValue, MinimumStock " &
                "FROM dbo.Products ORDER BY ProductID DESC"

            ' Creates a SQL command using the query and connection.
            Using cmd As New SqlCommand(query, con)

                ' Creates a data adapter to retrieve the query results.
                Using adapter As New SqlDataAdapter(cmd)

                    ' Creates an in-memory table to store the retrieved product records.
                    Dim dt As New DataTable()

                    ' Executes the SELECT query and fills the DataTable.
                    adapter.Fill(dt)

                    ' Displays the number of product records in the dashboard.
                    lblTotalProducts.Text = dt.Rows.Count.ToString()


                    ' Checks the stock quantity of every product against its minimum stock level.
                    For Each row As DataRow In dt.Rows

                        ' Converts the current stock quantity to an integer.
                        Dim stock As Integer =
                            Convert.ToInt32(row("StockQuantity"))

                        ' Converts the minimum stock threshold to an integer.
                        Dim minimumStock As Integer =
                            Convert.ToInt32(row("MinimumStock"))

                        ' Marks the product as low stock when stock is at or below the threshold.
                        If stock <= minimumStock Then

                            ' Appends LOW STOCK to the product name displayed in the table.
                            row("ProductName") =
                                row("ProductName").ToString() & " (LOW STOCK)"

                        End If

                    Next


                    ' Initializes the combined value of all products to zero.
                    Dim totalValue As Decimal = 0

                    ' Adds each product's calculated inventory value to the total.
                    For Each row As DataRow In dt.Rows

                        totalValue += Convert.ToDecimal(row("TotalValue"))

                    Next

                    ' Displays the total inventory value using two decimal places.
                    lblInventoryValue.Text = totalValue.ToString("N2")


                    ' Assigns the retrieved DataTable as the GridView's data source.
                    gvProducts.DataSource = dt

                    ' Displays the product records in the GridView.
                    gvProducts.DataBind()

                End Using
            End Using
        End Using

    End Sub


    ' Handles the Add Product button click event.
    ' Validates the input and inserts a new product into SQL Server.
    Protected Sub btnAddProduct_Click(sender As Object, e As EventArgs) Handles btnAddProduct.Click

        ' Reads the product code and removes leading and trailing spaces.
        Dim productCode As String = txtProductCode.Text.Trim()

        ' Reads the product name and removes leading and trailing spaces.
        Dim productName As String = txtProductName.Text.Trim()

        ' Variables used to store the validated price and stock quantity.
        Dim price As Decimal
        Dim stock As Integer


        ' Checks whether the product code or product name is empty.
        If productCode = "" OrElse productName = "" Then

            ' Displays a validation message if either required field is missing.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Please enter product code and product name.');", True)

            ' Stops the method when validation fails.
            Return

        End If


        ' Parses the price using invariant culture.
        ' Rejects invalid numbers and negative prices.
        If Not Decimal.TryParse(txtPrice.Text, NumberStyles.Number, CultureInfo.InvariantCulture, price) OrElse price < 0 Then

            ' Displays a message when the price is invalid.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Please enter a valid non-negative price.');", True)

            ' Stops the method when validation fails.
            Return

        End If


        ' Checks that the stock quantity is a valid whole number and is not negative.
        If Not Integer.TryParse(txtStock.Text, stock) OrElse stock < 0 Then

            ' Displays a validation message for an invalid stock quantity.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Stock quantity must be a non-negative whole number.');", True)

            ' Stops the method when validation fails.
            Return

        End If


        ' Retrieves the SQL Server connection string.
        Dim cs As String =
            ConfigurationManager.ConnectionStrings("InventoryDB").ConnectionString

        ' Handles database errors that may occur while inserting the product.
        Try

            ' Creates the SQL connection.
            Using con As New SqlConnection(cs)

                ' Inserts the new product into the Products table.
                ' SQL parameters are used instead of directly inserting user input into the query.
                Dim query As String =
                    "INSERT INTO Products " &
                    "(ProductCode, ProductName, Price, StockQuantity) " &
                    "VALUES (@ProductCode, @ProductName, @Price, @StockQuantity)"

                ' Creates the SQL command.
                Using cmd As New SqlCommand(query, con)

                    ' Supplies the product code parameter.
                    cmd.Parameters.AddWithValue("@ProductCode", productCode)

                    ' Supplies the product name parameter.
                    cmd.Parameters.AddWithValue("@ProductName", productName)

                    ' Supplies the validated price parameter.
                    cmd.Parameters.AddWithValue("@Price", price)

                    ' Supplies the validated stock quantity parameter.
                    cmd.Parameters.AddWithValue("@StockQuantity", stock)

                    ' Opens the database connection.
                    con.Open()

                    ' Executes the INSERT query to save the new product.
                    cmd.ExecuteNonQuery()

                End Using
            End Using


            ' Refreshes the product list and dashboard after insertion.
            LoadProducts()

            ' Clears the product code input field.
            txtProductCode.Text = ""

            ' Clears the product name input field.
            txtProductName.Text = ""

            ' Clears the price input field.
            txtPrice.Text = ""

            ' Clears the stock quantity input field.
            txtStock.Text = ""


            ' Displays a success message after the product has been inserted.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Product added successfully!');", True)


            ' Handles SQL Server-specific errors.
        Catch ex As SqlException

            ' SQL error 2601 or 2627 indicates a duplicate key or unique constraint violation.
            If ex.Number = 2601 OrElse ex.Number = 2627 Then

                ' Informs the user that the product code already exists.
                ClientScript.RegisterStartupScript(
                    Me.GetType(), "msg",
                    "alert('This product code already exists.');", True)

            Else

                ' Displays a general database error for other SQL exceptions.
                ClientScript.RegisterStartupScript(
                    Me.GetType(), "msg",
                    "alert('Database error. Please try again.');", True)

            End If


            ' Handles other errors that are not SQL exceptions.
        Catch ex As Exception

            ' Displays a general message if the product cannot be added.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Unable to add product. Please try again.');", True)

        End Try

    End Sub


    ' Handles the Update Product button click event.
    ' Validates the edited information and updates the selected database record.
    Protected Sub btnUpdateProduct_Click(sender As Object, e As EventArgs) Handles btnUpdateProduct.Click

        ' Variables used to store the selected product ID, price, and stock.
        Dim productID As Integer
        Dim price As Decimal
        Dim stock As Integer


        ' Checks whether the hidden product ID contains a valid integer.
        If Not Integer.TryParse(hfEditProductID.Value, productID) Then

            ' Stops the update if the product ID is invalid.
            Return

        End If


        ' Checks whether the product code or product name is empty.
        If txtEditProductCode.Text.Trim() = "" OrElse
           txtEditProductName.Text.Trim() = "" Then

            ' Displays a validation message when required fields are missing.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Product code and name are required.');", True)

            ' Stops the update when validation fails.
            Return

        End If


        ' Validates the edited price and prevents negative values.
        If Not Decimal.TryParse(txtEditPrice.Text, price) OrElse price < 0 Then

            ' Displays a validation message for an invalid price.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Enter a valid non-negative price.');", True)

            ' Stops the update when validation fails.
            Return

        End If


        ' Validates the edited stock quantity and prevents negative values.
        If Not Integer.TryParse(txtEditStock.Text, stock) OrElse stock < 0 Then

            ' Displays a validation message for an invalid stock quantity.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Stock must be a non-negative whole number.');", True)

            ' Stops the update when validation fails.
            Return

        End If


        ' Retrieves the SQL Server connection string.
        Dim cs As String =
            ConfigurationManager.ConnectionStrings("InventoryDB").ConnectionString

        ' Handles errors that may occur during the update operation.
        Try

            ' Creates the SQL database connection.
            Using con As New SqlConnection(cs)

                ' Updates the selected product using its ProductID.
                ' Only the specified product record is modified.
                Dim query As String =
                    "UPDATE dbo.Products SET ProductCode = @ProductCode, " &
                    "ProductName = @ProductName, Price = @Price, " &
                    "StockQuantity = @StockQuantity " &
                    "WHERE ProductID = @ProductID"

                ' Creates the SQL command.
                Using cmd As New SqlCommand(query, con)

                    ' Supplies the edited product code.
                    cmd.Parameters.AddWithValue(
                        "@ProductCode", txtEditProductCode.Text.Trim())

                    ' Supplies the edited product name.
                    cmd.Parameters.AddWithValue(
                        "@ProductName", txtEditProductName.Text.Trim())

                    ' Supplies the validated price.
                    cmd.Parameters.AddWithValue("@Price", price)

                    ' Supplies the validated stock quantity.
                    cmd.Parameters.AddWithValue("@StockQuantity", stock)

                    ' Supplies the ID identifying which product to update.
                    cmd.Parameters.AddWithValue("@ProductID", productID)

                    ' Opens the database connection.
                    con.Open()

                    ' Executes the UPDATE query.
                    cmd.ExecuteNonQuery()

                End Using
            End Using


            ' Hides the edit panel after the update operation.
            pnlEditProduct.Visible = False

            ' Refreshes the product table and dashboard statistics.
            LoadProducts()


            ' Displays a message confirming that the update operation completed.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Product updated successfully!');", True)


            ' Handles SQL Server-specific errors during the update.
        Catch ex As SqlException

            ' Checks whether the updated product code conflicts with a unique constraint.
            If ex.Number = 2601 OrElse ex.Number = 2627 Then

                ' Informs the user that the product code already exists.
                ClientScript.RegisterStartupScript(
                    Me.GetType(), "msg",
                    "alert('This product code already exists.');", True)

            Else

                ' Displays a general database error message.
                ClientScript.RegisterStartupScript(
                    Me.GetType(), "msg",
                    "alert('Database error while updating product.');", True)

            End If


            ' Handles other unexpected errors during the update operation.
        Catch ex As Exception

            ' Displays a general update failure message.
            ClientScript.RegisterStartupScript(
                Me.GetType(), "msg",
                "alert('Unable to update product. Please try again.');", True)

        End Try

    End Sub


    ' Handles the Cancel button click event in the Edit Product panel.
    Protected Sub btnCancelEdit_Click(sender As Object, e As EventArgs) Handles btnCancelEdit.Click

        ' Hides the Edit Product panel without saving changes.
        pnlEditProduct.Visible = False

        ' Clears the hidden product ID.
        hfEditProductID.Value = ""

        ' Clears the product code edit field.
        txtEditProductCode.Text = ""

        ' Clears the product name edit field.
        txtEditProductName.Text = ""

        ' Clears the price edit field.
        txtEditPrice.Text = ""

        ' Clears the stock quantity edit field.
        txtEditStock.Text = ""

    End Sub


    ' Handles the Logout button click event.
    Protected Sub btnLogout_Click(sender As Object, e As EventArgs) Handles btnLogout.Click

        ' Removes all values stored in the current session.
        Session.Clear()

        ' Abandons the current session.
        Session.Abandon()

        ' Redirects the user to the login page.
        Response.Redirect("Login.aspx")

    End Sub


End Class
